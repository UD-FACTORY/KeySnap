<Window x:Class="QuickReplace.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:QuickReplace.Helpers"
        mc:Ignorable="d"
        Title="KeySnap - 텍스트 대치 유틸리티" 
        Height="840" Width="1080"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Malgun Gothic"
        Icon="pack://application:,,,/app_icon.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="SidebarBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="SidebarItemHover" Color="#1E293B"/>
        <SolidColorBrush x:Key="SidebarItemSelected" Color="#334155"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentHover" Color="#4338CA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>

        <!-- Overrides for Tacky Windows System Selection Highlight -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>

        <!-- Modern Primary Button -->
        <Style x:Key="ModernPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Secondary Button -->
        <Style x:Key="ModernSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Small Button -->
        <Style x:Key="ModernDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small Action Button -->
        <Style x:Key="ModernSmallBtn" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Toggle Switch Style for CheckBox -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="SwitchTrack" Width="44" Height="24" CornerRadius="12" Background="#CBD5E1">
                                <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation RadioButton Style -->
        <Style x:Key="SidebarNavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="8" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SidebarItemHover}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SidebarItemSelected}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Row Style (Removes tacky bright blue highlight) -->
        <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="DGR_Border" Property="BorderBrush" Value="#C7D2FE"/>
                                <Setter TargetName="DGR_Border" Property="BorderThickness" Value="0,0,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Cell Style (Removes dotted focus line and overrides selection color) -->
        <Style x:Key="ModernDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/> <!-- Sidebar Navigation -->
            <ColumnDefinition Width="*"/>   <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        
        <!-- 1. LEFT SIDEBAR -->
        
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid Margin="16,20,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- App Brand & Icon -->
                    <RowDefinition Height="Auto"/> <!-- Status Badge -->
                    <RowDefinition Height="*"/>    <!-- Navigation Tabs -->
                    <RowDefinition Height="Auto"/> <!-- Global Master Toggle Card -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" ClipToBounds="True" Background="#1E293B">
                            <Image Source="pack://application:,,,/app_icon.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KeySnap" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC"/>
                            <TextBlock Text="텍스트 대치 유틸리티" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Row="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#132E27"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGlobalEnabled}" Value="False">
                                    <Setter Property="Background" Value="#25242C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#10B981"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGlobalEnabled}" Value="False">
                                            <Setter Property="Fill" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="서비스 동작 중"/>
                                    <Setter Property="Foreground" Value="#34D399"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGlobalEnabled}" Value="False">
                                            <Setter Property="Text" Value="대치 일시 중지"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Navigation Radio Buttons (Tab Switchers) -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="메뉴" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="8,0,0,8"/>

                    <RadioButton x:Name="TabNavShortcuts" GroupName="MainTabNav" Style="{StaticResource SidebarNavBtn}" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="단축어 관리" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabNavExclusions" GroupName="MainTabNav" Style="{StaticResource SidebarNavBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="예외 프로그램" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- 환경설정 탭 -->
                    <RadioButton x:Name="TabNavSettings" GroupName="MainTabNav" Style="{StaticResource SidebarNavBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="환경설정" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabNavGuide" GroupName="MainTabNav" Style="{StaticResource SidebarNavBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="사용 가이드" FontSize="13"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Master Toggle Card & Creator Footer in Sidebar Bottom -->
                <StackPanel Grid.Row="3">
                    <Border Background="#1E293B" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="전역 텍스트 대치" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                <TextBlock Text="모든 프로그램 적용" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" 
                                      IsChecked="{Binding IsGlobalEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Creator Info & Naver Blog Link -->
                    <Border Background="#0B132B" CornerRadius="8" Padding="12,8" BorderBrush="#1E293B" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="제작자 : 유디연구소" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="공식 블로그 바로가기" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Naver Blog Button with Green N Icon -->
                            <Button Grid.Column="1" Command="{Binding OpenBlogCommand}" Cursor="Hand" ToolTip="유디연구소 네이버 블로그 방문하기 (https://blog.naver.com/factoryud)"
                                    Background="Transparent" BorderThickness="0" Padding="2" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Border Background="#03C75A" CornerRadius="6" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="N" Foreground="White" FontWeight="ExtraBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        
        <!-- 2. RIGHT MAIN CONTENT AREA -->
        
        <Grid Grid.Column="1" Margin="28,24,28,24">

            
            <!-- 2 A. TAB 1: 단축어 관리 화면 -->
            
            <Grid Visibility="{Binding IsChecked, ElementName=TabNavShortcuts, Converter={StaticResource BoolToVisConverter}}" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Page Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Search & Action Bar -->
                    <RowDefinition Height="*"/>    <!-- DataGrid List Card -->
                </Grid.RowDefinitions>

                <!-- Header Title Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="단축어 관리" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="단축어 타이핑 시 자동으로 바뀔 문구들을 관리합니다." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Add & Import/Export Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernSecondaryBtn}" Content="가져오기" Command="{Binding ImportShortcutsCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ModernSecondaryBtn}" Content="내보내기" Command="{Binding ExportShortcutsCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ModernPrimaryBtn}" Content="+ 단축어 추가" Command="{Binding AddShortcutCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Search and Stats Summary Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="38" 
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     VerticalContentAlignment="Center" 
                                     FontSize="13"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#EEF2FF" CornerRadius="6" Padding="10,5" Margin="0,0,6,0">
                            <TextBlock FontSize="12" Foreground="#4338CA">
                                <Run Text="등록됨: " FontWeight="Medium"/>
                                <Run Text="{Binding TotalShortcutCount, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="10,5">
                            <TextBlock FontSize="12" Foreground="#047857">
                                <Run Text="활성: " FontWeight="Medium"/>
                                <Run Text="{Binding EnabledShortcutCount, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- DataGrid Card -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding FilteredShortcuts}"
                              SelectedItem="{Binding SelectedShortcut}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="White"
                              RowHeight="48"
                              BorderThickness="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource ModernDataGridRowStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- 활성 스위치 -->
                            <DataGridTemplateColumn Header="상태" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Checked="ShortcutCheckBox_Changed"
                                                  Unchecked="ShortcutCheckBox_Changed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 단축어 배지 -->
                            <DataGridTemplateColumn Header="단축어" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EEF2FF" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Shortcut}" FontWeight="Bold" Foreground="#4F46E5" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 대치어 -->
                            <DataGridTemplateColumn Header="대치 문구" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Replacement}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" 
                                                   FontSize="13" 
                                                   Foreground="#1E293B"
                                                   Margin="10,0"
                                                   ToolTip="{Binding Replacement}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 변환 방식 -->
                            <DataGridTemplateColumn Header="변환 방식" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding TriggerDisplay}" Foreground="#475569" FontSize="11" FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 그룹 -->
                            <DataGridTemplateColumn Header="그룹" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Group}" Foreground="#64748B" VerticalAlignment="Center" FontSize="12" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 관리 버튼 -->
                            <DataGridTemplateColumn Header="작업" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource ModernSmallBtn}" Content="수정" 
                                                    Command="{Binding DataContext.EditShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource ModernDangerBtn}" Content="삭제" 
                                                    Command="{Binding DataContext.DeleteShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            
            <!-- 2 B. TAB 2: 예외 프로그램 화면 -->
            
            <Grid Visibility="{Binding IsChecked, ElementName=TabNavExclusions, Converter={StaticResource BoolToVisConverter}}" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Page Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Search & Action Bar -->
                    <RowDefinition Height="*"/>    <!-- DataGrid List Card -->
                </Grid.RowDefinitions>

                <!-- Header Title Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="예외 프로그램 관리" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="게임(롤, 오버워치 등)이나 금융 보안 프로그램 등 텍스트 대치를 원치 않는 앱을 등록합니다." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernSecondaryBtn}" Content="파일 찾아보기(.exe)" Command="{Binding BrowseExclusionCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ModernPrimaryBtn}" Content="+ 프로그램 추가" Command="{Binding AddExclusionCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Search and Stats Summary Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding ExclusionSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="38" 
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     VerticalContentAlignment="Center" 
                                     FontSize="13"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#EEF2FF" CornerRadius="6" Padding="10,5" Margin="0,0,6,0">
                            <TextBlock FontSize="12" Foreground="#4338CA">
                                <Run Text="등록됨: " FontWeight="Medium"/>
                                <Run Text="{Binding TotalExclusionCount, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="10,5">
                            <TextBlock FontSize="12" Foreground="#047857">
                                <Run Text="적용 중: " FontWeight="Medium"/>
                                <Run Text="{Binding EnabledExclusionCount, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- DataGrid Card -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding FilteredExclusions}"
                              SelectedItem="{Binding SelectedExclusion}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="White"
                              RowHeight="48"
                              BorderThickness="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowStyle="{StaticResource ModernDataGridRowStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- 활성 스위치 -->
                            <DataGridTemplateColumn Header="상태" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Checked="ExclusionCheckBox_Changed"
                                                  Unchecked="ExclusionCheckBox_Changed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 프로세스 이름 배지 (수직 중앙 정렬) -->
                            <DataGridTemplateColumn Header="프로세스 이름" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Foreground="#334155" FontSize="13" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 설명 (수직 중앙 정렬) -->
                            <DataGridTemplateColumn Header="설명" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" FontSize="13" Foreground="#475569" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 작업 버튼 -->
                            <DataGridTemplateColumn Header="작업" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ModernDangerBtn}" Content="삭제" 
                                                Command="{Binding DataContext.DeleteExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            
            <!-- 2 C. TAB 3: 환경 설정 (옵션 전용 탭) -->
            
            <Grid Visibility="{Binding IsChecked, ElementName=TabNavSettings, Converter={StaticResource BoolToVisConverter}}" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="환경설정" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="애플리케이션의 시작 방식, 텍스트 치환 반응 속도 및 알림 설정을 지정합니다." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,16" HorizontalAlignment="Stretch">

                        <!-- 옵션 그룹 1: 시스템 및 부팅 -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🚀 시스템 및 구동 동작" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Windows 시작 시 자동 실행" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="컴퓨터가 부팅되면 백그라운드 트레이로 조용히 자동 실행됩니다." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.StartWithWindows}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator Background="#F1F5F9" Margin="0,4,0,8"/>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="창을 닫을 때 백그라운드 트레이로 숨기기" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="X 버튼을 눌러도 앱을 종료하지 않고 화면 우측 하단 트레이에 상주합니다." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.MinimizeToTrayOnClose}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 옵션 그룹 2: 치환 실행 단축키 & 클립보드 -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⚡ 치환 실행 단축키 및 클립보드" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                                <!-- 치환 실행 단축키 전용 컨테이너 (텍스트 잘림 방지 반응형 레이아웃) -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,2,0,10">
                                    <StackPanel>
                                        <!-- 1단계: 제목 & 단축키 변경 버튼 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="치환 실행 단축키 (트리거 키)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                                <TextBlock Text="단축어를 입력한 후 이 키를 누르면 즉시 대치어로 치환됩니다." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- 단축키 표시 & 변경 버튼 영역 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- 일반 모드: 현재 단축키 배지 및 변경 버튼 -->
                                                <Border Visibility="{Binding IsRecordingHotkey, Converter={StaticResource InverseBoolToVisConverter}}"
                                                        Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1.5" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SelectedTriggerHotkeyDisplay}" FontWeight="Bold" FontSize="13" Foreground="#4338CA" VerticalAlignment="Center"/>
                                                </Border>

                                                <Button Visibility="{Binding IsRecordingHotkey, Converter={StaticResource InverseBoolToVisConverter}}"
                                                        Style="{StaticResource ModernPrimaryBtn}" 
                                                        Content="⌨ 단축키 변경" 
                                                        Command="{Binding StartRecordingHotkeyCommand}" 
                                                        Height="34" Padding="12,0" Margin="0,0,6,0"/>

                                                <Button Visibility="{Binding IsRecordingHotkey, Converter={StaticResource InverseBoolToVisConverter}}"
                                                        Style="{StaticResource ModernSecondaryBtn}" 
                                                        Content="기본값 (Tab)" 
                                                        Command="{Binding ResetTriggerHotkeyCommand}" 
                                                        Height="34" Padding="10,0"/>

                                                <!-- 녹화 중 모드: 깜빡이는 강조 배지 및 취소 버튼 -->
                                                <Border Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVisConverter}}"
                                                        Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="2" CornerRadius="8" Padding="14,6" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔴 " FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RecordingPrompt}" FontWeight="Bold" FontSize="12" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <Button Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVisConverter}}"
                                                        Style="{StaticResource ModernSecondaryBtn}" 
                                                        Content="취소 (ESC)" 
                                                        Command="{Binding CancelRecordingHotkeyCommand}" 
                                                        Height="34" Padding="12,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Separator Background="#E2E8F0" Margin="0,0,0,8"/>

                                        <!-- 2단계: 추천 프리셋 드롭다운 및 사용 안내 팁 (줄바꿈 지원) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="빠른 추천 프리셋:" FontSize="12" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox Height="28" Width="130"
                                                          ItemsSource="{Binding AvailableTriggerHotkeys}"
                                                          SelectedItem="{Binding SelectedTriggerHotkey}"
                                                          VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" 
                                                       Text="💡 프리셋 목록에 없는 조합(예: Alt+Q, Ctrl+Shift+K, F9 등)은 [⌨ 단축키 변경] 클릭 후 원하는 키를 누르면 바로 등록됩니다." 
                                                       FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="클립보드 복원 대기 지연 시간 (ms)" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="대치어를 붙여넣은 뒤 원래 클립보드를 복원할 때까지의 대기 시간입니다. (기본 권장값: 80ms)" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding Settings.ClipboardRestoreDelayMs, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="34" Padding="8,4" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                             BorderBrush="#CBD5E1" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 옵션 그룹 3: 알림 및 피드백 -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🔔 알림 및 시각 피드백" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="텍스트 대치 시 풍선 알림 표시" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="치환이 완료되었을 때 우측 하단에 알림 메시지를 표시합니다." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.ShowNotifications}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 설정 저장 버튼 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                            <Button Style="{StaticResource ModernPrimaryBtn}" Content="설정 저장 완료" Command="{Binding SaveSettingsCommand}" Padding="24,10"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            
            <!-- 2 D. TAB 4: 사용 가이드 화면 -->
            
            <Grid Visibility="{Binding IsChecked, ElementName=TabNavGuide, Converter={StaticResource BoolToVisConverter}}" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="사용 가이드 및 팁" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="KeySnap을 200% 활용할 수 있는 단축어 팁과 매크로 태그입니다." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,24" HorizontalAlignment="Stretch">
                        <!-- Card 0: 트리거 방식 안내 -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚡ 단축어 입력 후 치환 단축키(기본: Tab) 누르기" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="단축어(예: ㅇㅈ 또는 addr)를 입력한 뒤 지정된 단축키(기본 Tab)를 누르면 입력창 포커스 이동 없이 즉시 대치어로 치환됩니다." FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="치환 단축키는 [환경설정] 탭의 [⌨ 단축키 변경]을 통해 Tab, Space, Ctrl+Space, Alt+Q, F1~F12 등 원하는 임의의 키로 자유롭게 지정할 수 있습니다." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 1 -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="✨ 한글 두벌식 키보드 지원" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <TextBlock Text="한/영 전환 키를 누르지 않아도 키보드 자판대로 바로 타이핑 후 단축키를 누르면 인식됩니다." FontSize="13" Foreground="#475569" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="ㅇㅈ" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Border>
                                    <TextBlock Text="➔  인정합니다. 👍" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="ㄱㅅ" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Border>
                                    <TextBlock Text="➔  감사합니다! 좋은 하루 보내세요. 😊" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2 -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🏷️ 동적 매크로 태그 안내" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <TextBlock Text="대치어 안에 아래 태그를 넣으면 치환 순간의 실제 데이터로 자동 채워집니다." FontSize="13" Foreground="#475569" Margin="0,0,0,10"/>

                                <TextBlock Text="• {{today}} 또는 !오늘날짜 : 현재 오늘 날짜 (예: 2026-09-23)" FontSize="13" Margin="0,3"/>
                                <TextBlock Text="• {{time}} 또는 !현재시간 : 현재 시각 (예: 15:30:00)" FontSize="13" Margin="0,3"/>
                                <TextBlock Text="• {{clipboard}} 또는 !클립보드 : 현재 컴퓨터 클립보드에 복사된 텍스트" FontSize="13" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3 -->
                        <Border Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
