<Window x:Class="QuickReplace.Views.ShortcutEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="단축어 설정" Height="540" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Malgun Gothic"
        Icon="pack://application:,,,/app_icon.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4338CA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderBrush" Value="#C7D2FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="단축어 추가 / 편집" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="입력할 단축어와 대치될 문구를 지정하세요." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 단축어 입력 -->
                <TextBlock Text="단축어 (예: ㅇㅈ, !email, addr)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" Height="40"/>

                <!-- 변환 방식 (트리거) -->
                <TextBlock Text="변환 방식 (트리거)" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="즉시 변환 (단축어 타이핑 즉시)" IsChecked="{Binding IsInstantTrigger}" Margin="0,0,24,0" Foreground="#334155" FontSize="13"/>
                    <RadioButton Content="트리거 키 입력 시 (Space / Enter)" IsChecked="{Binding IsKeyTrigger}" Foreground="#334155" FontSize="13"/>
                </StackPanel>

                <!-- 대치어 입력 -->
                <TextBlock Text="대치어 (치환될 문구)" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,6"/>
                
                <!-- 매크로 빠른 삽입 칩 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="매크로 삽입:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ChipButton}" Content="+ 오늘날짜" Command="{Binding InsertMacroCommand}" CommandParameter="{}{{{today}}}"/>
                    <Button Style="{StaticResource ChipButton}" Content="+ 현재시간" Command="{Binding InsertMacroCommand}" CommandParameter="{}{{{time}}}"/>
                    <Button Style="{StaticResource ChipButton}" Content="+ 클립보드" Command="{Binding InsertMacroCommand}" CommandParameter="{}{{{clipboard}}}"/>
                </StackPanel>
                
                <TextBox Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         Height="120" 
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"/>

                <!-- 그룹/카테고리 -->
                <TextBlock Text="그룹 (선택 사항)" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,6"/>
                <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Height="40"/>

                <!-- 에러 메시지 -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,8,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="취소" Click="CancelButton_Click" Margin="0,0,8,0" Width="84"/>
            <Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click" Width="84"/>
        </StackPanel>
    </Grid>
</Window>
